# Copy this file to backend/.env and fill in the values. NEVER commit backend/.env.

# Generate with:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
TIME_ZONE=Asia/Kolkata
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# MySQL
DB_NAME=meettrack
DB_USER=meettrack_user
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=3306

# AI provider. "openai" works with any OpenAI-compatible API, "anthropic" uses the Claude API.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=90
AI_EXTERNAL_PROCESSING_ENABLED=true

# Limits
MAX_UPLOAD_MB=5
AI_ANALYSIS_RATE=10/hour
AUTH_RATE=20/min

# Email (password reset). Development prints the reset link in the backend terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For real email use: django.core.mail.backends.smtp.EmailBackend plus these:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=MeetTrack AI <no-reply@yourdomain.com>

# Production only (core.settings.production)
# SECURE_SSL_REDIRECT=true
# CSRF_TRUSTED_ORIGINS=https://api.yourdomain.com
# ADMIN_URL=some-private-path/
